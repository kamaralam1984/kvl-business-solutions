# =======================
# KVL Business Solutions
# Copy this file to .env.local and fill in your values
# =======================

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASS@cluster.xxx.mongodb.net/kvl?retryWrites=true&w=majority

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# Google OAuth (optional) — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=xxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxx

# Admin seed account (run `npm run seed` to create)
ADMIN_EMAIL=admin@kvlsolutions.in
ADMIN_PASSWORD=ChangeMe!2026

# Razorpay (https://dashboard.razorpay.com → Settings → API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx

# Razorpay Webhook secret (Dashboard → Settings → Webhooks)
# Configure webhook URL: {NEXT_PUBLIC_SITE_URL}/api/payments/webhook
# Subscribe events: payment.captured, payment.failed, refund.processed
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxx

# Anthropic Claude API for AI chatbot
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend for transactional emails (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="KVL Solutions <noreply@kvlsolutions.in>"
EMAIL_TO_SALES=sales@kvlsolutions.in

# Cloudinary for file uploads (ticket attachments, product images)
# Sign up: https://cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=xxxxxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP=919000000000

# Cal.com booking widget (optional) — leave blank to use the in-house form
# Format: "username/event-slug" e.g., "kvl-sales/30min"
NEXT_PUBLIC_CAL_USERNAME=

# Cron secret (protects /api/cron/* routes when not invoked by Vercel Cron)
# Generate: openssl rand -base64 32
# Vercel Cron auto-authenticates; for local/manual tests use: curl -H "Authorization: Bearer $CRON_SECRET" ...
CRON_SECRET=replace-with-openssl-rand-base64-32

# Google Analytics 4 (optional) — leave blank to disable
NEXT_PUBLIC_GA_ID=

# Marketing pixels (all optional, each independently no-ops when blank — see
# components/analytics/*.tsx). All gated behind the same cookie-consent banner
# as Google Analytics.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_CLARITY_ID=

# Google Ads conversion tracking (optional, no-ops when blank — see
# components/analytics/GoogleAdsConversion.tsx and track.ts)
# Main account tag, format "AW-XXXXXXXXX" (Google Ads → Tools → Conversions → your account ID)
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Per-event conversion labels, format "AW-XXXXXXXXX/AbCdEfGhIj" — one conversion
# action per event type, created under Google Ads → Tools → Conversions → + New
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LEAD=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_BOOKING=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_PROPOSAL=

# Search engine verification (optional)
# Google Search Console → Settings → Ownership verification → HTML tag → the "content" value only
NEXT_PUBLIC_GSC_VERIFICATION=
# Bing Webmaster Tools → Settings → verify ownership → HTML meta tag → the "content" value only
NEXT_PUBLIC_BING_VERIFICATION=
# IndexNow key (any IndexNow-compatible generator, e.g. bing.com/indexnow) —
# served at https://{domain}/{INDEXNOW_KEY}.txt by app/[indexnowkey]/route.ts
INDEXNOW_KEY=
